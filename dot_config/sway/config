## Sway master config. Structure borrowed from Archcraft, keybinds are mine (from i3).
## Reload with $mod+Shift+c.

##-- Mod keys ----------------------------
set $mod Mod4

##-- Font --------------------------------
font pango:FiraCode Nerd Font 9

##-- Variables ---------------------------
set $TERM foot
set $BROWSER firefox
set $FILE_MANAGER thunar
set $volume ~/.config/sway/scripts/volume
set $backlight ~/.config/sway/scripts/brightness

##-- General settings --------------------
default_orientation horizontal
workspace_layout default
xwayland enable
floating_modifier $mod normal
mouse_warping none
focus_follows_mouse yes
popup_during_fullscreen smart
focus_on_window_activation smart
swaynag_command swaynag

##-- Included files ----------------------
include ~/.config/sway/sway-input
include ~/.config/sway/sway-output
include ~/.config/sway/sway-theme
include ~/.config/sway/sway-modes
include ~/.config/sway/sway-idle

##-- Startup (waybar, dunst, nm-applet, kanshi) --
exec_always ~/.config/sway/scripts/startup

##-- Basic keybinds ----------------------
bindsym $mod+Return exec $TERM
bindsym $mod+b exec $BROWSER
bindsym $mod+f exec $FILE_MANAGER

# kill focused window
bindsym $mod+q kill

# rofi: run launcher and window switcher
bindsym $mod+space exec rofi -show run    -theme ~/.config/rofi/launcher.rasi
bindsym $mod+d     exec rofi -show window -theme ~/.config/rofi/launcher.rasi

##-- Function keys -----------------------
bindsym XF86AudioRaiseVolume exec $volume --inc
bindsym XF86AudioLowerVolume exec $volume --dec
bindsym XF86AudioMute        exec $volume --toggle
bindsym XF86AudioMicMute     exec $volume --toggle-mic
bindsym XF86MonBrightnessUp   exec $backlight --inc
bindsym XF86MonBrightnessDown exec $backlight --dec

##-- Focus -------------------------------
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

##-- Move --------------------------------
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

##-- Splits, layout ----------------------
bindsym $mod+h split horizontal
bindsym $mod+v split vertical

bindsym $mod+F11 fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+Ctrl+space focus mode_toggle
bindsym $mod+a focus parent

##-- Workspaces --------------------------
bindsym $mod+Tab       workspace next
bindsym $mod+Shift+Tab workspace prev

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

##-- Session -----------------------------
bindsym $mod+Shift+c reload
# Sway has no separate "restart" like i3; reload also restarts waybar and dunst
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway? This ends your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

##-- Optional extras (unbound in my i3 config; uncomment if wanted) --
#bindsym $mod+Escape exec swaylock -f

##-- Window rules (find app_id: swaymsg -t get_tree | grep app_id) --
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="GtkFileChooserDialog"] floating enable
for_window [app_id="pavucontrol|nm-connection-editor|blueman-manager"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="thunar" title="Rename.*"] floating enable
for_window [app_id="thunar" title="File Operation Progress.*"] floating enable
for_window [app_id="thunar" title="Confirm to replace.*"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable

include /etc/sway/config.d/*
