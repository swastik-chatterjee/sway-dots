##-- Input -------------------------------
# Names of your inputs: swaymsg -t get_inputs
# Docs: man 5 sway-input

## Touchpad / mouse
input "*" {
    dwt enabled
    tap enabled
    natural_scroll disabled
    middle_emulation enabled
}

