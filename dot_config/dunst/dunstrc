[global]
    monitor = 0
    follow = none

    width = 300
    height = 300
    origin = top-right
    offset = 30x80

    notification_limit = 6
    padding = 8
    horizontal_padding = 13
    separator_height = 2
    frame_width = 4
    frame_color = "#323d43"
    separator_color = "#3c474d"
    corner_radius = 2

    font = FiraCode Nerd Font Bold 10
    markup = full
    format = "<span size='x-large' font_desc='FiraCode Nerd Font 11' weight='bold' foreground='#a7c080'>%s</span>\n\n%b"
    alignment = center
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = false
    hide_duplicate_count = yes
    show_indicators = no
    sort = no

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150

    idle_threshold = 120
    show_age_threshold = 60
    sticky_history = no
    history_length = 20

    icon_position = left
    max_icon_size = 96
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita

    browser = firefox
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+Escape
    context = ctrl+shift+period

[urgency_low]
    background = "#323d43"
    foreground = "#d8caac"
    timeout = 10

[urgency_normal]
    background = "#323d43"
    foreground = "#d8caac"
    timeout = 10

[urgency_critical]
    background = "#323d43"
    foreground = "#d8caac"
    frame_color = "#e67e80"
    timeout = 120
