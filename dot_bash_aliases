# General
alias cp="cp -iv"
alias mv="mv -iv"
alias mkdir="mkdir -pv"
alias cls="clear"
alias c="clear"
alias h="history"
alias path='echo -e "${PATH//:/\\n}"'

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias -- -="cd -"

# ls
alias ls="ls --color=auto --group-directories-first"
alias la="ls -A"
alias ll="ls -alh"
alias l="ls -lh"

# Colorize
alias grep="grep --color=auto"
alias diff="diff --color=auto"
alias ip="ip -color=auto"

# Disk / system
alias df="df -h"
alias du="du -h"
alias free="free -h"

# Fedora packages
alias pewup="sudo dnf upgrade --refresh"
alias pewrm="sudo dnf remove"
alias pewin="sudo dnf install"
alias pewsr="dnf search"
alias pewcl="sudo dnf autoremove && sudo dnf clean all"

# Git
alias gs="git status -sb"
alias ga="git add"
alias gc="git commit"
alias gcm="git commit -m"
alias gp="git push"
alias gl="git pull"
alias gd="git diff"
alias glog="git log --oneline --graph --decorate -20"

# Python
alias aenv="source .venv/bin/activate"
alias cenv="python3 -m venv .venv"
alias denv="deactivate"
alias pipu="pip install pip --upgrade"
alias pipr="pip install -r requirements.txt"

# Helix and configs
alias hxconf="cd $HOME/.config/helix && hx"
alias swayconf="hx $HOME/.config/sway/config"
alias waybarconf="hx $HOME/.config/waybar/config.jsonc"
alias footconf="hx $HOME/.config/foot/foot.ini"
alias swayreload="swaymsg reload"
alias bashconf="hx $HOME/.bashrc && source $HOME/.bashrc"
